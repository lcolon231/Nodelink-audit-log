# Alchemy RPC endpoint for Sepolia testnet
# Get one free at https://dashboard.alchemy.com
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Private key of the wallet that will deploy and sign transactions
# NEVER commit a key with real funds — use a dedicated testnet wallet
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Address of the deployed AuditLog contract (set after running: npx hardhat run scripts/deploy.js --network sepolia)
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Port for the Express backend (optional, defaults to 3001)
PORT=3001
